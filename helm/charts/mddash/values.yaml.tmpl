{{- $cfg := (datasource "config") -}}
{{- $namespace := $cfg.namespace -}}
{{- $helmPackage := $cfg.helm.package -}}
{{- $imageTag := (getenv "IMAGE_TAG" $cfg.imageTag) -}}
jupyterhub:
  hub:
    resources:
      requests:
        cpu: {{ $cfg.hub.resources.requests.cpu }}
        memory: {{ $cfg.hub.resources.requests.memory }}
      limits:
        cpu: {{ $cfg.hub.resources.limits.cpu }}
        memory: {{ $cfg.hub.resources.limits.memory }}
    # custom image that supports access through JWT tokens
    image:
      name: eginotebooks/hub
      tag: "sha-4ffff9e"
    config:
      JupyterHub:
        authenticator_class: generic-oauth
      GenericOAuthenticator:
        login_service: "{{ $cfg.oidc.loginService }}"
        authorize_url: {{ $cfg.oidc.authorizeUrl }}
        token_url: {{ $cfg.oidc.tokenUrl }}
        userdata_url: {{ $cfg.oidc.userdataUrl }}
        oauth_callback_url: https://{{ $cfg.dashboard.hostname }}/hub/oauth_callback
        client_id: null  # gets imported from env OAUTH_CLIENT_ID
        client_secret: null  # gets imported from env OAUTH_CLIENT_SECRET
        userdata_params:
          state: state
        scope:
{{ $cfg.oidc.scope | toYAML | indent 10 }}
        username_key: {{ $cfg.oidc.usernameKey }}
        allow_all: {{ $cfg.oidc.allowAll }}
      KubeSpawner:
        services_enabled: true
        events_enabled: false
        http_timeout: 120

    extraEnv:
      HOSTNAME:
        value: "{{ $cfg.dashboard.hostname }}"
      HELM_PACKAGE:
        value: "{{ $helmPackage }}"
      IMAGE_PULL_POLICY:
        value: "{{ $cfg.sidecars.pullPolicy | default "Always" }}"
      RANCHER_PROJECT_ID:
        value: "{{ $cfg.rancherProjectId }}"  # Set the Rancher project ID for namespace annotation
      OAUTH_CLIENT_ID:
        valueFrom:
          secretKeyRef:
            name: oidc-credentials
            key: client_id
      OAUTH_CLIENT_SECRET:
        valueFrom:
          secretKeyRef:
            name: oidc-credentials
            key: client_secret
      S3_ENDPOINT:
        value: "{{ $cfg.s3.endpoint }}"
      S3_ACCESS_KEY:
        valueFrom:
          secretKeyRef:
            name: {{ $helmPackage }}-s3-creds
            key: S3_ACCESS_KEY
      S3_SECRET_KEY:
        valueFrom:
          secretKeyRef:
            name: {{ $helmPackage }}-s3-creds
            key: S3_SECRET_KEY
      # User namespace resource quota
      NS_REQUESTS_CPU:
        value: "{{ $cfg.resources.namespaceQuota.requestsCpu }}"
      NS_REQUESTS_MEMORY:
        value: "{{ $cfg.resources.namespaceQuota.requestsMemory }}"
      NS_LIMITS_CPU:
        value: "{{ $cfg.resources.namespaceQuota.limitsCpu }}"
      NS_LIMITS_MEMORY:
        value: "{{ $cfg.resources.namespaceQuota.limitsMemory }}"
      NS_MAX_NOTEBOOKS:
        value: "{{ $cfg.resources.notebookQuota.maxConcurrent }}"
      # Notebook pod resource configuration
      NOTEBOOK_CPU_REQUEST:
        value: "{{ $cfg.resources.notebook.cpuRequest }}"
      NOTEBOOK_MEMORY_REQUEST:
        value: "{{ $cfg.resources.notebook.memoryRequest }}"
      NOTEBOOK_CPU_LIMIT:
        value: "{{ $cfg.resources.notebook.cpuLimit }}"
      NOTEBOOK_MEMORY_LIMIT:
        value: "{{ $cfg.resources.notebook.memoryLimit }}"
      GMX_CPU_REQUEST:
        value: "{{ $cfg.resources.notebook.gmxCpuRequest }}"
      GMX_MEMORY_REQUEST:
        value: "{{ $cfg.resources.notebook.gmxMemoryRequest }}"
      GMX_CPU_LIMIT:
        value: "{{ $cfg.resources.notebook.gmxCpuLimit }}"
      GMX_MEMORY_LIMIT:
        value: "{{ $cfg.resources.notebook.gmxMemoryLimit }}"
      NOTEBOOK_IDLE_TIMEOUT:
        value: "{{ $cfg.resources.notebook.idleTimeoutSeconds }}"

      ANALYSIS_CPU_REQUEST:
        value: "{{ $cfg.resources.analysisJob.cpuRequest }}"
      ANALYSIS_MEMORY_REQUEST:
        value: "{{ $cfg.resources.analysisJob.memoryRequest }}"
      ANALYSIS_CPU_LIMIT:
        value: "{{ $cfg.resources.analysisJob.cpuLimit }}"
      ANALYSIS_MEMORY_LIMIT:
        value: "{{ $cfg.resources.analysisJob.memoryLimit }}"
      PVC_STORAGE_SIZE:
        value: "{{ $cfg.resources.pvcStorageSize }}"
      PVC_STORAGE_CLASS:
        value: "{{ $cfg.storageClassName }}"
      # Sidecar container images - used by pre_spawn_hook.py to configure extra_containers
      PROXY_IMAGE:
        value: "{{ $cfg.sidecars.proxy.image }}:{{ $imageTag }}"
      AUTH_IMAGE:
        value: "{{ $cfg.sidecars.auth.image }}:{{ $imageTag }}"
      API_IMAGE:
        value: "{{ $cfg.sidecars.api.image }}:{{ $imageTag }}"
      S3_SYNC_IMAGE:
        value: "{{ $cfg.sidecars.s3sync.image }}:{{ $imageTag }}"
      NOTEBOOK_IMAGE:
        value: "{{ $cfg.notebook.image }}:{{ $imageTag }}"
      ANALYSIS_IMAGE:
        value: "{{ $cfg.analysis.image }}"
      GMX_IMAGE:
        value: "{{ $cfg.gmxImage }}"
      GPU_TYPE:
        value: "{{ $cfg.gpuType }}"
      DEFAULT_NOTEBOOKS_REPO:
        value: "{{ $cfg.defaultNotebooksRepo }}"
      # MDRepo OAuth for publishing experiments to the repository
      MDREPO_URL:
        value: "{{ $cfg.mdrepo.url }}"
      MDREPO_SCOPES:
        value: "{{ $cfg.mdrepo.scopes }}"
      MDREPO_CLIENT_ID:
        valueFrom:
          secretKeyRef:
            name: {{ $helmPackage }}-mdrepo-credentials
            key: client_id
      MDREPO_CLIENT_SECRET:
        valueFrom:
          secretKeyRef:
            name: {{ $helmPackage }}-mdrepo-credentials
            key: client_secret
      TUNER_USER:
        valueFrom:
          secretKeyRef:
            name: tuner-auth
            key: user
      TUNER_PASSWORD:
        valueFrom:
          secretKeyRef:
            name: tuner-auth
            key: password

    extraVolumes:
      - name: custom-templates
        configMap:
          name: {{ $helmPackage }}-custom-templates  # created in Makefile
    extraVolumeMounts:
      - name: custom-templates
        mountPath: /opt/jupyterhub/custom-templates

    extraConfig:
      oauth-client-secret: |
        import os
        c.GenericOAuthenticator.client_id = os.environ.get("OAUTH_CLIENT_ID")
        c.GenericOAuthenticator.client_secret = os.environ.get("OAUTH_CLIENT_SECRET")
      customTemplates: |
        c.JupyterHub.template_paths = ["/opt/jupyterhub/custom-templates"]

    networkPolicy:
      enabled: false

    command:
      - sh
      - "-c"
      - "pip3 install jupyterhub-jwtauthenticator && exec jupyterhub --config /usr/local/etc/jupyterhub/jupyterhub_config.py --upgrade-db"
  
  singleuser:
    podNameTemplate: "{{ $helmPackage }}-{username}"
    # Use stock JupyterHub singleuser image - sidecars handle all custom functionality
    image:
      name: quay.io/jupyterhub/singleuser
      tag: "5"
      pullPolicy: IfNotPresent

    cmd: ["jupyterhub-singleuser", "--port=8080"]

    # Default URL to redirect after spawn
    defaultUrl: "/dash"

    # Resource limits for the notebook container
    memory:
      guarantee: {{ $cfg.resources.singleuser.memory.guarantee }}
      limit: {{ $cfg.resources.singleuser.memory.limit }}
    cpu:
      guarantee: {{ $cfg.resources.singleuser.cpu.guarantee }}
      limit: {{ $cfg.resources.singleuser.cpu.limit }}

    # Increased timeout for sidecar startup
    startTimeout: 600

    # Storage is configured manually in pre_spawn_hook.py
    storage:
      type: none

    networkPolicy:
      enabled: false

    uid: 1000
    fsGid: 1000
    extraEnv:
      JUPYTERHUB_SINGLEUSER_APP:
        value: "jupyter_server.serverapp.ServerApp"
      POD_NAMESPACE:
        valueFrom:
          fieldRef:
            fieldPath: metadata.namespace

    extraPodConfig:
      securityContext:
        fsGroupChangePolicy: OnRootMismatch
        runAsNonRoot: true
        seccompProfile:
          type: RuntimeDefault
    cloudMetadata:
      blockWithIptables: false

  proxy:
    secretToken: "your-secret-token-here-change-me"

  # Requires cluster-wide permissions to be enabled
  scheduling:
    userScheduler:
      enabled: false

  prePuller:
    continuous:
      enabled: false
    # disabled because it was exceeding resource limit and preventing the chart from installing
    hook:
      enabled: false

  ingress:
    enabled: true
    hosts:
      - {{ $cfg.dashboard.hostname }}
    tls:
      - hosts:
          - {{ $cfg.dashboard.hostname }}
        secretName: {{ $cfg.dashboard.hostname | strings.ReplaceAll "." "-" }}-tls
    annotations:
      kubernetes.io/ingress.class: nginx
      cert-manager.io/cluster-issuer: letsencrypt-prod
      nginx.ingress.kubernetes.io/proxy-body-size: "8g"
      nginx.ingress.kubernetes.io/proxy-read-timeout: "3600"
      nginx.ingress.kubernetes.io/proxy-send-timeout: "3600"
      nginx.ingress.kubernetes.io/custom-http-errors: "599"

mdrun-api:
  image:
    repository: {{ $cfg.mdrunApi.image }}
    tag: "{{ $cfg.mdrunApi.tag | default $imageTag }}"
    pullPolicy: Always
  storage:
    size: {{ $cfg.mdrunApi.storage.size }}
  uwsgi:
    processes: 2
    threads: 4
  replicaCount: 1
  env:
    - name: S3_ACCESS_KEY
      valueFrom:
        secretKeyRef:
          name: {{ $helmPackage }}-s3-creds
          key: S3_ACCESS_KEY
    - name: S3_SECRET_KEY
      valueFrom:
        secretKeyRef:
          name: {{ $helmPackage }}-s3-creds
          key: S3_SECRET_KEY
    - name: S3_ENDPOINT
      value: "{{ $cfg.s3.endpoint }}"
    - name: GMX_IMAGE
      value: "{{ $cfg.gmxImage }}"
    - name: GPU_TYPE
      value: "{{ $cfg.gpuType }}"

gromacs-tuner:
  image:
    repository: {{ $cfg.gromacsTuner.image.repository }}
    tag: "{{ $cfg.gromacsTuner.image.tag }}"
    pullPolicy: "{{ $cfg.gromacsTuner.image.pullPolicy }}"

  ingress:
    enabled: false
    host: "gromacs-tuner.local"

  # API resources
  api:
    resources:
{{ $cfg.gromacsTuner.api.resources | toYAML | indent 6 }}

  # Storage configuration
  storage:
    size: "{{ $cfg.gromacsTuner.storage.size }}"
    storageClassName: "{{ $cfg.storageClassName }}"

  # Ray cluster configuration
  ray:
    version: "2.42.1"
    image: "{{ $cfg.gromacsTuner.ray.image }}"
    autoscaler:
      idleTimeoutSeconds: "{{ $cfg.gromacsTuner.ray.worker.idleTimeoutSeconds }}"

    head:
      resources:
{{ $cfg.gromacsTuner.ray.head.resources | toYAML | indent 8 }}

    worker:
      maxReplicas: {{ $cfg.gromacsTuner.ray.worker.maxReplicas }}
      numCpu: {{ $cfg.gromacsTuner.ray.worker.resources.limits.cpu }}
      {{- $numGpu := 0 -}}
      {{- range $k, $v := $cfg.gromacsTuner.ray.worker.resources.limits -}}
        {{- if or (strings.HasPrefix "nvidia.com/" $k) (strings.Contains (strings.ToLower $k) "gpu") -}}
          {{- $numGpu = $v -}}
        {{- end -}}
      {{- end }}
      numGpu: {{ $numGpu }}
      resources:
{{ $cfg.gromacsTuner.ray.worker.resources | toYAML | indent 8 }}
