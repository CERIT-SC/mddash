{{- $cfg := (datasource "config") -}}
{{- $namespace := $cfg.namespace -}}
{{- $helmPackage := $cfg.helm.package -}}
jupyterhub:
  hub:
    config:
      JupyterHub:
        authenticator_class: generic-oauth
      GenericOAuthenticator:
        login_service: "e-INFRA CZ"  # button label
        authorize_url: https://login.e-infra.cz/oidc/authorize
        token_url: https://login.e-infra.cz/oidc/token
        userdata_url: https://login.e-infra.cz/oidc/userinfo
        oauth_callback_url: https://{{ $cfg.dashboard.hostname }}/hub/oauth_callback
        client_id: null  # gets imported from env OAUTH_CLIENT_ID
        client_secret: null  # gets imported from env OAUTH_CLIENT_SECRET
        userdata_params:
          state: state
        scope:
          - openid
          - profile
          - email
        username_key: preferred_username
        allow_all: true
      KubeSpawner:
        services_enabled: true
        http_timeout: 60

    extraEnv:
      HELM_PACKAGE:
        value: "{{ $helmPackage }}"
      RANCHER_PROJECT_ID:
        value: "{{ $cfg.rancherProjectId }}"  # Set the Rancher project ID for namespace annotation
      OAUTH_CLIENT_ID:
        valueFrom:
          secretKeyRef:
            name: oidc-credentials
            key: client_id
      OAUTH_CLIENT_SECRET:
        valueFrom:
          secretKeyRef:
            name: oidc-credentials
            key: client_secret
      S3_ENDPOINT:
        value: "http://minio.{{ $namespace }}.svc.cluster.local:80"
      S3_ACCESS_KEY:
        valueFrom:
          secretKeyRef:
            name: {{ $helmPackage }}-s3-creds
            key: S3_ACCESS_KEY
      S3_SECRET_KEY:
        valueFrom:
          secretKeyRef:
            name: {{ $helmPackage }}-s3-creds
            key: S3_SECRET_KEY
      # User namespace resource quota
      NS_REQUESTS_CPU:
        value: "{{ $cfg.resources.namespaceQuota.requestsCpu }}"
      NS_REQUESTS_MEMORY:
        value: "{{ $cfg.resources.namespaceQuota.requestsMemory }}"
      NS_LIMITS_CPU:
        value: "{{ $cfg.resources.namespaceQuota.limitsCpu }}"
      NS_LIMITS_MEMORY:
        value: "{{ $cfg.resources.namespaceQuota.limitsMemory }}"
      PVC_STORAGE_SIZE:
        value: "{{ $cfg.resources.pvcStorageSize }}"
      PVC_STORAGE_CLASS:
        value: "{{ $cfg.storageClassName }}"
      # Sidecar container images - used by pre_spawn_hook.py to configure extra_containers
      PROXY_IMAGE:
        value: "{{ $cfg.sidecars.proxy.image }}:{{ $cfg.sidecars.tag }}"
      AUTH_IMAGE:
        value: "{{ $cfg.sidecars.auth.image }}:{{ $cfg.sidecars.tag }}"
      API_IMAGE:
        value: "{{ $cfg.sidecars.api.image }}:{{ $cfg.sidecars.tag }}"
      S3_SYNC_IMAGE:
        value: "{{ $cfg.sidecars.s3sync.image }}:{{ $cfg.sidecars.tag }}"
      NOTEBOOK_IMAGE:
        value: "{{ $cfg.notebook.image }}:{{ $cfg.notebook.tag }}"

    extraVolumes:
      - name: kubeconfig
        secret:
          secretName: {{ $helmPackage }}-kubeconfig-secret
      - name: custom-templates
        configMap:
          name: {{ $helmPackage }}-custom-templates  # created in Makefile
    extraVolumeMounts:
      - name: kubeconfig
        mountPath: /home/jovyan/.kube
        readOnly: true
      - name: custom-templates
        mountPath: /opt/jupyterhub/custom-templates

    extraConfig:
      oauth-client-secret: |
        import os
        c.GenericOAuthenticator.client_id = os.environ.get("OAUTH_CLIENT_ID")
        c.GenericOAuthenticator.client_secret = os.environ.get("OAUTH_CLIENT_SECRET")
      customTemplates: |
        c.JupyterHub.template_paths = ["/opt/jupyterhub/custom-templates"]

    networkPolicy:
      enabled: false

  singleuser:
    podNameTemplate: "{{ $helmPackage }}-{username}"
    # Use stock JupyterHub singleuser image - sidecars handle all custom functionality
    image:
      name: quay.io/jupyterhub/singleuser
      tag: "5"
      pullPolicy: IfNotPresent

    # Run notebook on port 8080 (proxy uses 8888)
    extraEnv:
      JUPYTERHUB_SINGLEUSER_APP:
        value: "jupyter_server.serverapp.ServerApp"
    cmd: ["jupyterhub-singleuser", "--port=8080"]

    # Default URL to redirect after spawn
    defaultUrl: "/dash"

    # Resource limits for the notebook container
    memory:
      guarantee: {{ $cfg.resources.singleuser.memory.guarantee }}
      limit: {{ $cfg.resources.singleuser.memory.limit }}
    cpu:
      guarantee: {{ $cfg.resources.singleuser.cpu.guarantee }}
      limit: {{ $cfg.resources.singleuser.cpu.limit }}

    # Increased timeout for sidecar startup
    startTimeout: 600

    # Storage is configured manually in pre_spawn_hook.py
    storage:
      type: none

    networkPolicy:
      enabled: false

    uid: 1000
    fsGid: 1000
    extraEnv:
      POD_NAMESPACE:
        valueFrom:
          fieldRef:
            fieldPath: metadata.namespace

    extraPodConfig:
      securityContext:
        fsGroupChangePolicy: OnRootMismatch
        runAsNonRoot: true
        seccompProfile:
          type: RuntimeDefault
    cloudMetadata:
      blockWithIptables: false

  proxy:
    secretToken: "your-secret-token-here-change-me"

  # TODO: Requires cluster-wide permissions to be enabled
  scheduling:
    userScheduler:
      enabled: false

  prePuller:
    continuous:
      enabled: false
    # disabled because it was exceeding resource limit and preventing the chart from installing
    hook:
      enabled: false

  ingress:
    enabled: true
    hosts:
      - {{ $cfg.dashboard.hostname }}
    tls:
      - hosts:
          - {{ $cfg.dashboard.hostname }}
        secretName: {{ $cfg.dashboard.hostname | strings.ReplaceAll "." "-" }}-tls
    annotations:
      kubernetes.io/ingress.class: nginx
      cert-manager.io/cluster-issuer: letsencrypt-prod
      nginx.ingress.kubernetes.io/proxy-body-size: "100m"
      nginx.ingress.kubernetes.io/proxy-read-timeout: "3600"
      nginx.ingress.kubernetes.io/proxy-send-timeout: "3600"

mdrun-api:
  image:
    repository: {{ $cfg.mdrunApi.image }}
    tag: "{{ $cfg.mdrunApi.tag }}"
    pullPolicy: Always
  storage:
    size: {{ $cfg.mdrunApi.storage.size }}
  uwsgi:
    processes: 2
    threads: 4
  replicaCount: 1
  env:
    - name: S3_ACCESS_KEY
      valueFrom:
        secretKeyRef:
          name: {{ $helmPackage }}-s3-creds
          key: S3_ACCESS_KEY
    - name: S3_SECRET_KEY
      valueFrom:
        secretKeyRef:
          name: {{ $helmPackage }}-s3-creds
          key: S3_SECRET_KEY
    - name: S3_ENDPOINT
      value: "http://minio.{{ $namespace }}.svc.cluster.local:80"

tenant:
  tenant:
    name: minio
    configSecret:
      name: minio-root-config
      existingSecret: true
    # this is outdated, but CI/CD pipeline fails without it
    configuration:
      name: minio-root-config
    pools:
      - servers: {{ $cfg.minio.servers }}
        name: pool-0
        volumesPerServer: {{ $cfg.minio.volumesPerServer }}
        size: {{ $cfg.minio.poolSize }}
        storageClassName: {{ $cfg.storageClassName }}
        securityContext:
          runAsNonRoot: true
          runAsUser: 1000
          runAsGroup: 1000
          fsGroup: 1000
          seccompProfile:
            type: RuntimeDefault
        containerSecurityContext:
          allowPrivilegeEscalation: false
          runAsNonRoot: true
          runAsUser: 1000
          runAsGroup: 1000
          capabilities:
            drop:
              - ALL
          seccompProfile:
            type: RuntimeDefault
    requestAutoCert: false
    buckets: []
    certificate:
      requestAutoCert: false
    features:
      bucketDNS: false
    podManagementPolicy: Parallel
    exposeServices:
      minio: true
    serviceMetadata:
      minioServiceLabels:
        service-type: "minio-api"
    liveness:
      httpGet:
        path: /minio/health/live
        port: 9000
        scheme: HTTP
      initialDelaySeconds: 10
      periodSeconds: 1
      timeoutSeconds: 1
    readiness:
      httpGet:
        path: /minio/health/ready
        port: 9000
        scheme: HTTP
      initialDelaySeconds: 10
      periodSeconds: 1
      timeoutSeconds: 1
