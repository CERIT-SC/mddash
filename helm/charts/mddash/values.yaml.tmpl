{{- $cfg := (datasource "config") -}}
{{- $env := (getenv "ENV") -}}
{{- if not (or (eq $env "dev") (eq $env "prod")) -}}
  {{- fail "ENV must be 'dev' or 'prod'" -}}
{{- end -}}
{{- $namespace := (index $cfg (printf "%sNamespace" $env)) -}}
jupyterhub:
  hub:
    config:
      JupyterHub:
        authenticator_class: generic-oauth
      GenericOAuthenticator:
        login_service: "e-INFRA CZ"  # button label
        authorize_url: https://login.e-infra.cz/oidc/authorize
        token_url: https://login.e-infra.cz/oidc/token
        userdata_url: https://login.e-infra.cz/oidc/userinfo
        oauth_callback_url: https://{{ index $cfg.dashboard (printf "%sHostname" $env) }}/hub/oauth_callback
        client_id: null  # gets imported from env OAUTH_CLIENT_ID
        client_secret: null  # gets imported from env OAUTH_CLIENT_SECRET
        userdata_params:
          state: state
        scope:
          - openid
          - profile
          - email
        username_key: preferred_username
        allow_all: true
      KubeSpawner:
        services_enabled: true
        http_timeout: 60

    extraEnv:
      RANCHER_PROJECT_ID:
        value: "{{ index $cfg (printf "%sRancherProjectId" $env) }}"  # Set the Rancher project ID for namespace annotation
      OAUTH_CLIENT_ID:
        valueFrom:
          secretKeyRef:
            name: oidc-credentials
            key: client_id
      OAUTH_CLIENT_SECRET:
        valueFrom:
          secretKeyRef:
            name: oidc-credentials
            key: client_secret
      S3_ENDPOINT:
        value: "http://minio.{{ $namespace }}.svc.cluster.local:80"
      S3_ACCESS_KEY:
        valueFrom:
          secretKeyRef:
            name: mddash-s3-creds
            key: S3_ACCESS_KEY
      S3_SECRET_KEY:
        valueFrom:
          secretKeyRef:
            name: mddash-s3-creds
            key: S3_SECRET_KEY
      # User namespace resource quota
      NS_REQUESTS_CPU:
        value: "{{ index $cfg.resources $env "namespaceQuota" "requestsCpu" }}"
      NS_REQUESTS_MEMORY:
        value: "{{ index $cfg.resources $env "namespaceQuota" "requestsMemory" }}"
      NS_LIMITS_CPU:
        value: "{{ index $cfg.resources $env "namespaceQuota" "limitsCpu" }}"
      NS_LIMITS_MEMORY:
        value: "{{ index $cfg.resources $env "namespaceQuota" "limitsMemory" }}"

    extraVolumes:
      - name: kubeconfig
        secret:
          secretName: mddash-kubeconfig-secret
      - name: custom-templates
        configMap:
          name: mddash-custom-templates  # created in Makefile
    extraVolumeMounts:
      - name: kubeconfig
        mountPath: /home/jovyan/.kube
        readOnly: true
      - name: custom-templates
        mountPath: /opt/jupyterhub/custom-templates

    extraConfig:
      oauth-client-secret: |
        import os
        c.GenericOAuthenticator.client_id = os.environ.get("OAUTH_CLIENT_ID")
        c.GenericOAuthenticator.client_secret = os.environ.get("OAUTH_CLIENT_SECRET")
      customTemplates: |
        c.JupyterHub.template_paths = ["/opt/jupyterhub/custom-templates"]

    networkPolicy:
      enabled: false

  singleuser:
    podNameTemplate: "mddash-{username}"
    image:
      name: "{{ $cfg.dashboard.image }}"
      tag: "{{ index $cfg.dashboard (printf "%sTag" $env) }}"
      pullPolicy: Always  # TODO: change to `ifNotPresent` once the image is stable

    # Default URL to redirect after spawn
    defaultUrl: "/dash"

    # Resource limits
    memory:
      guarantee: {{ index $cfg.resources $env "singleuser" "memory" "guarantee" }}
      limit: {{ index $cfg.resources $env "singleuser" "memory" "limit" }}
    cpu:
      guarantee: {{ index $cfg.resources $env "singleuser" "cpu" "guarantee" }}
      limit: {{ index $cfg.resources $env "singleuser" "cpu" "limit" }}

    # Increased timeout for custom image startup
    startTimeout: 600

    # Use S3 storage mounted at /mddash
    storage:
      type: none

    networkPolicy:
      enabled: false

    uid: 1000
    fsGid: 100
    extraEnv:
      POD_NAMESPACE:
        valueFrom:
          fieldRef:
            fieldPath: metadata.namespace
      NOTEBOOK_IMAGE:
        value: "{{ $cfg.notebook.image }}:{{ index $cfg.notebook (printf "%sTag" $env) }}"

    extraPodConfig:
      securityContext:
        fsGroupChangePolicy: OnRootMismatch
        runAsNonRoot: true
        seccompProfile:
          type: RuntimeDefault
    cloudMetadata:
      blockWithIptables: false

  proxy:
    secretToken: "your-secret-token-here-change-me"

  # TODO: Requires cluster-wide permissions to be enabled
  scheduling:
    userScheduler:
      enabled: false

  prePuller:
    continuous:
      enabled: false
    # disabled because it was exceeding resource limit and preventing the chart from installing
    hook:
      enabled: false

  ingress:
    enabled: true
    hosts:
      - {{ index $cfg.dashboard (printf "%sHostname" $env) }}
    tls:
      - hosts:
          - {{ index $cfg.dashboard (printf "%sHostname" $env) }}
        secretName: {{ index $cfg.dashboard (printf "%sHostname" $env) | strings.ReplaceAll "." "-" }}-tls
    annotations:
      kubernetes.io/ingress.class: nginx
      cert-manager.io/cluster-issuer: letsencrypt-prod
      nginx.ingress.kubernetes.io/proxy-body-size: "100m"
      nginx.ingress.kubernetes.io/proxy-read-timeout: "3600"
      nginx.ingress.kubernetes.io/proxy-send-timeout: "3600"

mdrun-api:
  image:
    repository: {{ $cfg.mdrunApi.image }}
    tag: "{{ index $cfg.mdrunApi (printf "%sTag" $env) }}"
    pullPolicy: Always
  storage:
    size: {{ index $cfg.mdrunApi.storage (printf "%sSize" $env) }}
  uwsgi:
    processes: 2
    threads: 4
  replicaCount: 1
  env:
    - name: S3_ACCESS_KEY
      valueFrom:
        secretKeyRef:
          name: mddash-s3-creds
          key: S3_ACCESS_KEY
    - name: S3_SECRET_KEY
      valueFrom:
        secretKeyRef:
          name: mddash-s3-creds
          key: S3_SECRET_KEY
    - name: S3_ENDPOINT
      value: "http://minio.{{ $namespace }}.svc.cluster.local:80"

tenant:
  tenant:
    name: minio
    configSecret:
      name: minio-root-config
      existingSecret: true
    pools:
      - servers: {{ $cfg.minio.servers }}
        name: pool-0
        volumesPerServer: {{ $cfg.minio.volumesPerServer }}
        size: {{ index $cfg.minio (printf "%sPoolSize" $env) }}
        storageClassName: {{ $cfg.storageClassName }}
        securityContext:
          runAsNonRoot: true
          runAsUser: 1000
          runAsGroup: 1000
          fsGroup: 1000
          seccompProfile:
            type: RuntimeDefault
        containerSecurityContext:
          allowPrivilegeEscalation: false
          runAsNonRoot: true
          runAsUser: 1000
          runAsGroup: 1000
          capabilities:
            drop:
              - ALL
          seccompProfile:
            type: RuntimeDefault
    requestAutoCert: false
    buckets: []
    certificate:
      requestAutoCert: false
    features:
      bucketDNS: false
    podManagementPolicy: Parallel
    exposeServices:
      minio: true
    serviceMetadata:
      minioServiceLabels:
        service-type: "minio-api"
    liveness:
      httpGet:
        path: /minio/health/live
        port: 9000
        scheme: HTTP
      initialDelaySeconds: 10
      periodSeconds: 1
      timeoutSeconds: 1
    readiness:
      httpGet:
        path: /minio/health/ready
        port: 9000
        scheme: HTTP
      initialDelaySeconds: 10
      periodSeconds: 1
      timeoutSeconds: 1
