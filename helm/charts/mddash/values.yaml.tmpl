{{- $cfg := (datasource "config") -}}
{{- $namespace := $cfg.namespace -}}
{{- $helmPackage := $cfg.helm.package -}}
jupyterhub:
  hub:
    config:
      JupyterHub:
        authenticator_class: generic-oauth
      GenericOAuthenticator:
        login_service: "e-INFRA CZ"  # button label
        authorize_url: https://login.e-infra.cz/oidc/authorize
        token_url: https://login.e-infra.cz/oidc/token
        userdata_url: https://login.e-infra.cz/oidc/userinfo
        oauth_callback_url: https://{{ $cfg.dashboard.hostname }}/hub/oauth_callback
        client_id: null  # gets imported from env OAUTH_CLIENT_ID
        client_secret: null  # gets imported from env OAUTH_CLIENT_SECRET
        userdata_params:
          state: state
        scope:
          - openid
          - profile
          - email
        username_key: preferred_username
        allow_all: true
      KubeSpawner:
        services_enabled: true
        http_timeout: 60

    extraEnv:
      HELM_PACKAGE:
        value: "{{ $helmPackage }}"
      RANCHER_PROJECT_ID:
        value: "{{ $cfg.rancherProjectId }}"  # Set the Rancher project ID for namespace annotation
      OAUTH_CLIENT_ID:
        valueFrom:
          secretKeyRef:
            name: oidc-credentials
            key: client_id
      OAUTH_CLIENT_SECRET:
        valueFrom:
          secretKeyRef:
            name: oidc-credentials
            key: client_secret
      S3_ENDPOINT:
        value: "http://minio.{{ $namespace }}.svc.cluster.local:80"
      S3_ACCESS_KEY:
        valueFrom:
          secretKeyRef:
            name: {{ $helmPackage }}-s3-creds
            key: S3_ACCESS_KEY
      S3_SECRET_KEY:
        valueFrom:
          secretKeyRef:
            name: {{ $helmPackage }}-s3-creds
            key: S3_SECRET_KEY
      NOTEBOOK_IMAGE:
        value: "{{ $cfg.notebook.image }}:{{ $cfg.notebook.tag }}"
      # User namespace resource quota
      NS_REQUESTS_CPU:
        value: "{{ $cfg.resources.namespaceQuota.requestsCpu }}"
      NS_REQUESTS_MEMORY:
        value: "{{ $cfg.resources.namespaceQuota.requestsMemory }}"
      NS_LIMITS_CPU:
        value: "{{ $cfg.resources.namespaceQuota.limitsCpu }}"
      NS_LIMITS_MEMORY:
        value: "{{ $cfg.resources.namespaceQuota.limitsMemory }}"
      PVC_STORAGE_SIZE:
        value: "{{ $cfg.resources.pvcStorageSize }}"
      PVC_STORAGE_CLASS:
        value: "{{ $cfg.storageClassName }}"

    extraVolumes:
      - name: kubeconfig
        secret:
          secretName: {{ $helmPackage }}-kubeconfig-secret
      - name: custom-templates
        configMap:
          name: {{ $helmPackage }}-custom-templates  # created in Makefile
    extraVolumeMounts:
      - name: kubeconfig
        mountPath: /home/jovyan/.kube
        readOnly: true
      - name: custom-templates
        mountPath: /opt/jupyterhub/custom-templates

    extraConfig:
      oauth-client-secret: |
        import os
        c.GenericOAuthenticator.client_id = os.environ.get("OAUTH_CLIENT_ID")
        c.GenericOAuthenticator.client_secret = os.environ.get("OAUTH_CLIENT_SECRET")
      customTemplates: |
        c.JupyterHub.template_paths = ["/opt/jupyterhub/custom-templates"]

    networkPolicy:
      enabled: false

  singleuser:
    podNameTemplate: "{{ $helmPackage }}-{username}"
    # Main container is the proxy (receives traffic on 8888)
    image:
      name: "{{ $cfg.dashboard.containers.proxy.image }}"
      tag: "{{ $cfg.dashboard.containers.proxy.tag }}"
      pullPolicy: Always

    # Default URL to redirect after spawn
    defaultUrl: "/dash"

    # Resource limits for main proxy container
    memory:
      guarantee: {{ $cfg.resources.proxy.memory.guarantee }}
      limit: {{ $cfg.resources.proxy.memory.limit }}
    cpu:
      guarantee: {{ $cfg.resources.proxy.cpu.guarantee }}
      limit: {{ $cfg.resources.proxy.cpu.limit }}

    # Increased timeout for custom image startup
    startTimeout: 600

    # PVC is created inside pre_spawn_hook.py
    storage:
      type: none

    networkPolicy:
      enabled: false

    uid: 1000
    fsGid: 1000
    extraEnv:
      POD_NAMESPACE:
        valueFrom:
          fieldRef:
            fieldPath: metadata.namespace
      NOTEBOOK_IMAGE:
        value: "{{ $cfg.notebook.image }}:{{ $cfg.notebook.tag }}"

    extraPodConfig:
      securityContext:
        fsGroupChangePolicy: OnRootMismatch
        runAsNonRoot: true
        seccompProfile:
          type: RuntimeDefault
    cloudMetadata:
      blockWithIptables: false

    # Extra containers for the singleuser pod
    extraContainers:
      # API container - handles backend API and auth
      - name: api
        image: "{{ $cfg.dashboard.containers.api.image }}:{{ $cfg.dashboard.containers.api.tag }}"
        imagePullPolicy: Always
        ports:
          - containerPort: 5000
            name: api
          - containerPort: 5001
            name: auth
        env:
          - name: POD_NAMESPACE
            valueFrom:
              fieldRef:
                fieldPath: metadata.namespace
          - name: S3_ENDPOINT
            value: "http://minio.{{ $namespace }}.svc.cluster.local:80"
          - name: S3_ACCESS_KEY
            valueFrom:
              secretKeyRef:
                name: {{ $helmPackage }}-s3-creds
                key: S3_ACCESS_KEY
          - name: S3_SECRET_KEY
            valueFrom:
              secretKeyRef:
                name: {{ $helmPackage }}-s3-creds
                key: S3_SECRET_KEY
        volumeMounts:
          - name: mddash-data
            mountPath: /mddash
        resources:
          limits:
            cpu: "0.5"
            memory: 512M
          requests:
            cpu: "0.1"
            memory: 128M
        securityContext:
          allowPrivilegeEscalation: false
          runAsNonRoot: true
          runAsUser: 1000
          capabilities:
            drop:
              - ALL
          seccompProfile:
            type: RuntimeDefault

      # Jupyter container - handles notebook interface
      - name: jupyter
        image: "{{ $cfg.dashboard.containers.jupyter.image }}:{{ $cfg.dashboard.containers.jupyter.tag }}"
        imagePullPolicy: Always
        ports:
          - containerPort: 8889
            name: jupyter
        resources:
          limits:
            cpu: {{ $cfg.resources.singleuser.cpu.limit }}
            memory: {{ $cfg.resources.singleuser.memory.limit }}
          requests:
            cpu: {{ $cfg.resources.singleuser.cpu.guarantee }}
            memory: {{ $cfg.resources.singleuser.memory.guarantee }}
        securityContext:
          allowPrivilegeEscalation: false
          runAsNonRoot: true
          runAsUser: 1000
          capabilities:
            drop:
              - ALL
          seccompProfile:
            type: RuntimeDefault

      # S3 sync sidecar - handles data synchronization
      - name: s3-sync
        image: "{{ $cfg.dashboard.containers.s3Sync.image }}:{{ $cfg.dashboard.containers.s3Sync.tag }}"
        imagePullPolicy: Always
        env:
          - name: S3_ENDPOINT
            value: "http://minio.{{ $namespace }}.svc.cluster.local:80"
          - name: S3_ACCESS_KEY
            valueFrom:
              secretKeyRef:
                name: {{ $helmPackage }}-s3-creds
                key: S3_ACCESS_KEY
          - name: S3_SECRET_KEY
            valueFrom:
              secretKeyRef:
                name: {{ $helmPackage }}-s3-creds
                key: S3_SECRET_KEY
        volumeMounts:
          - name: mddash-data
            mountPath: /mddash
        resources:
          limits:
            cpu: "0.2"
            memory: 256M
          requests:
            cpu: "0.05"
            memory: 64M
        securityContext:
          allowPrivilegeEscalation: false
          runAsNonRoot: true
          runAsUser: 1000
          capabilities:
            drop:
              - ALL
          seccompProfile:
            type: RuntimeDefault

    # Shared volumes
    extraVolumes:
      - name: mddash-data
        persistentVolumeClaim:
          claimName: {{ $helmPackage }}-user-pvc

  proxy:
    secretToken: "your-secret-token-here-change-me"

  # TODO: Requires cluster-wide permissions to be enabled
  scheduling:
    userScheduler:
      enabled: false

  prePuller:
    continuous:
      enabled: false
    # disabled because it was exceeding resource limit and preventing the chart from installing
    hook:
      enabled: false

  ingress:
    enabled: true
    hosts:
      - {{ $cfg.dashboard.hostname }}
    tls:
      - hosts:
          - {{ $cfg.dashboard.hostname }}
        secretName: {{ $cfg.dashboard.hostname | strings.ReplaceAll "." "-" }}-tls
    annotations:
      kubernetes.io/ingress.class: nginx
      cert-manager.io/cluster-issuer: letsencrypt-prod
      nginx.ingress.kubernetes.io/proxy-body-size: "100m"
      nginx.ingress.kubernetes.io/proxy-read-timeout: "3600"
      nginx.ingress.kubernetes.io/proxy-send-timeout: "3600"

mdrun-api:
  image:
    repository: {{ $cfg.mdrunApi.image }}
    tag: "{{ $cfg.mdrunApi.tag }}"
    pullPolicy: Always
  storage:
    size: {{ $cfg.mdrunApi.storage.size }}
  uwsgi:
    processes: 2
    threads: 4
  replicaCount: 1
  env:
    - name: S3_ACCESS_KEY
      valueFrom:
        secretKeyRef:
          name: {{ $helmPackage }}-s3-creds
          key: S3_ACCESS_KEY
    - name: S3_SECRET_KEY
      valueFrom:
        secretKeyRef:
          name: {{ $helmPackage }}-s3-creds
          key: S3_SECRET_KEY
    - name: S3_ENDPOINT
      value: "http://minio.{{ $namespace }}.svc.cluster.local:80"

tenant:
  tenant:
    name: minio
    configSecret:
      name: minio-root-config
      existingSecret: true
    # this is outdated, but CI/CD pipeline fails without it
    configuration:
      name: minio-root-config
    pools:
      - servers: {{ $cfg.minio.servers }}
        name: pool-0
        volumesPerServer: {{ $cfg.minio.volumesPerServer }}
        size: {{ $cfg.minio.poolSize }}
        storageClassName: {{ $cfg.storageClassName }}
        securityContext:
          runAsNonRoot: true
          runAsUser: 1000
          runAsGroup: 1000
          fsGroup: 1000
          seccompProfile:
            type: RuntimeDefault
        containerSecurityContext:
          allowPrivilegeEscalation: false
          runAsNonRoot: true
          runAsUser: 1000
          runAsGroup: 1000
          capabilities:
            drop:
              - ALL
          seccompProfile:
            type: RuntimeDefault
    requestAutoCert: false
    buckets: []
    certificate:
      requestAutoCert: false
    features:
      bucketDNS: false
    podManagementPolicy: Parallel
    exposeServices:
      minio: true
    serviceMetadata:
      minioServiceLabels:
        service-type: "minio-api"
    liveness:
      httpGet:
        path: /minio/health/live
        port: 9000
        scheme: HTTP
      initialDelaySeconds: 10
      periodSeconds: 1
      timeoutSeconds: 1
    readiness:
      httpGet:
        path: /minio/health/ready
        port: 9000
        scheme: HTTP
      initialDelaySeconds: 10
      periodSeconds: 1
      timeoutSeconds: 1
