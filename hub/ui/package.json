{
  "name": "hub-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --base /",
    "knip": "knip",
    "build": "tsc -b && vite build && pnpm run validate",
    "validate": "node scripts/validate-build.mjs",
    "type-check": "tsc --noEmit",
    "preview": "vite preview",
    "format": "prettier --write --log-level warn \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "@e-infra/design-system": "^0.1.9",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "knip": "^6.37.0",
    "vite": "^8.3.0"
  }
}
