// For format details, see https://aka.ms/devcontainer.json. For config options, see the
{
	"build": {
		"dockerfile": "./Dockerfile",
		"context": "."
	},

	// Features to add to the dev container. More info: https://containers.dev/features.
	"features": {
		"ghcr.io/devcontainers/features/node:2": {
			"version": "26",
			"pnpmVersion": "11.13.0"
		},
		"ghcr.io/devcontainers/features/python:1": {
			"version": "3.12",
			"toolsToInstall": "uv"
		},
		"ghcr.io/devcontainers/features/docker-in-docker:4": {
			"moby": false,
			"dockerDashComposeVersion": "none",
			"installDockerComposeSwitch": false
		},
		"ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {
			"minikube": "none" // don't install minikube
		},
		"ghcr.io/devcontainers/features/github-cli:1": {}
	},

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],

	// Use 'postCreateCommand' to run commands after the container is built.
	"postCreateCommand": ".devcontainer/post-create.sh",

	// Use 'updateContentCommand' to run commands on every container start.
	"updateContentCommand": "git fetch --all --prune",

	// Configure tool-specific properties.
	"customizations": {
		"vscode": {
			// Some VS Code extensions you probably want installed in the container.
			"extensions": [
				"docker.docker",
				"ms-kubernetes-tools.vscode-kubernetes-tools",
				"ms-python.python",
				"redhat.vscode-yaml",
				"esbenp.prettier-vscode",
				"charliermarsh.ruff",
				"astral-sh.ty"
			],
			"settings": {
				"[python]": {
					"editor.formatOnSave": true,
					"editor.defaultFormatter": "charliermarsh.ruff"
				},
				"[typescript]": {
					"editor.formatOnSave": true,
					"editor.defaultFormatter": "esbenp.prettier-vscode"
				},
				"[typescriptreact]": {
					"editor.formatOnSave": true,
					"editor.defaultFormatter": "esbenp.prettier-vscode"
				},
				"python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python",
				"ruff.interpreter": ["${containerWorkspaceFolder}/.venv/bin/python"],
				"ty.interpreter": "${containerWorkspaceFolder}/.venv/bin/python",
				"terminal.integrated.env.linux": {
					"PATH": "/home/vscode/.local/bin:${env:PATH}"
				}
			}
		}
	},

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"

	// Persist home dir across container rebuilds
	"mounts": [
		"source=mddash-home,target=/home/vscode,type=volume"
	]
}
