{
  "name": "dash",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "api:generate": "orval --config orval.config.ts",
    "api:check": "pnpm api:generate && git diff --exit-code -- src/api/generated",
    "build": "vite build",
    "dev": "vite",
    "routes:generate": "tsr generate",
    "test": "pnpm routes:generate && vitest run",
    "type-check": "pnpm routes:generate && tsc --noEmit",
    "format": "prettier --ignore-path ../../.prettierignore --write --log-level warn \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --ignore-path ../../.prettierignore --check \"src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "@e-infra/design-system": "^0.1.9",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.99.1",
    "@tanstack/react-router": "^1.168.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.85.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@tanstack/router-plugin": "^1.168.30",
    "@tanstack/router-cli": "1.167.28",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "msw": "2.15.0",
    "orval": "8.24.0",
    "sass": "^1.99.0",
    "vite": "^6.4.2",
    "vitest": "^3.2.4"
  }
}
