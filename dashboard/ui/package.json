{
  "name": "dash",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "api:generate": "orval --config orval.config.ts",
    "generated:check": "pnpm api:generate && pnpm routes:generate && git diff --exit-code -- src/api/generated src/routeTree.gen.ts",
    "knip": "knip",
    "build": "vite build",
    "dev": "vite",
    "routes:generate": "tsr generate",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "format": "prettier --ignore-path ../../.prettierignore --write --log-level warn \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --ignore-path ../../.prettierignore --check \"src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "@e-infra/design-system": "^0.1.9",
    "@hookform/resolvers": "^5.9.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-router": "^1.170.38",
    "ansi-to-html": "^0.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "lucide-react": "^1.47.0",
    "molstar": "^5.11.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-dropzone": "^20.1.2",
    "react-hook-form": "^7.88.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tanstack/router-cli": "1.167.38",
    "@tanstack/router-plugin": "^1.168.40",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "~26.1.0",
    "knip": "^6.37.0",
    "orval": "8.34.0",
    "sass": "^1.104.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
