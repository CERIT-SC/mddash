{
    log {
        output file /caddy/default.log
        level INFO
        format console
    }

    # Enable the Admin API
    admin 0.0.0.0:2019

    # Store Caddy's state (like certificates) in /caddy/data
    storage file_system {
        root /caddy/data
    }

    # Disable automatic HTTPS because k8s handles certificates
    auto_https off
}

http://:8888 {
    log {
        output file /caddy/access.log
        format console
    }

    # Handle JupyterHub prefix
    handle_path {$CADDY_ROUTE_PREFIX}/* {

        # API proxy
        route /api/* {
            reverse_proxy localhost:5000
        }

        # add trailing slash for /dash
        @dash_needs_slash {
            path /dash
        }
        redir @dash_needs_slash {$CADDY_ROUTE_PREFIX}/dash/ 308

        # dashboard website
        route /dash/* {
            root * /var/tmp

            @not_a_file {
                not file {path}
            }
            rewrite @not_a_file /dash/index.html

            file_server
            encode zstd gzip
        }
    }

    # Fallback response
    route {
      respond "Where the hell do you think you are going?" 404
    }
}
