{
    log {
        output file /caddy/default.log
        level INFO
        format console
    }

    admin 0.0.0.0:2019

    storage file_system {
        root /caddy/data
    }

    auto_https off
}

http://:8888 {
    # NOTE: When changing something here, it can break the ./api/clients/caddy.py logic!

    log {
        output file /caddy/access.log
        format console
    }

    # OAuth callback route
    @oauth_callback {
        path {$CADDY_ROUTE_PREFIX}/oauth_callback*
    }
    handle @oauth_callback {
        uri strip_prefix {$CADDY_ROUTE_PREFIX}
        reverse_proxy localhost:5001
    }

    # API routes
    @api_routes {
        path_regexp ^{$CADDY_ROUTE_PREFIX}/dash/api.*$
    }
    handle @api_routes {
        forward_auth localhost:5001 {
            uri /auth
        }

        reverse_proxy localhost:5000
    }

    # /dash -> /dash/
    @dash_redirect {
        path {$CADDY_ROUTE_PREFIX}/dash
    }
    redir @dash_redirect {$CADDY_ROUTE_PREFIX}/dash/ 308

    # Dynamic config.js for React app - injects runtime configuration
    @config_js {
        path {$CADDY_ROUTE_PREFIX}/dash/config.js
    }
    handle @config_js {
        forward_auth localhost:5001 {
            uri /auth
        }
        header Content-Type "application/javascript"
        respond `window.MDDASH_CONFIG = {
    basePath: "{$CADDY_ROUTE_PREFIX}/dash",
    apiPath: "{$CADDY_ROUTE_PREFIX}/dash/api",
    user: "{$JUPYTERHUB_USER}"
};`
    }

    # Dashboard routes
    @dash_routes {
        path_regexp ^{$CADDY_ROUTE_PREFIX}/dash/.*$
    }
    handle @dash_routes {
        forward_auth localhost:5001 {
            uri /auth
        }

        root * /opt/dash

        @is_asset {
            path_regexp ^{$CADDY_ROUTE_PREFIX}/dash/(.*)$
        }
        rewrite @is_asset /{re.1}

        @not_a_file {
            not file {path}
        }
        rewrite @not_a_file /index.html

        try_files {path} /index.html

        file_server
        encode zstd gzip
    }

    # JupyterHub - everything else
    handle {$CADDY_ROUTE_PREFIX}* {
        reverse_proxy localhost:8889
    }

    # Fallback
    route {
        respond "Where the hell do you think you are going?" 404
    }
}
