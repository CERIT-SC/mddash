{
    # Enable the Admin API
    admin 0.0.0.0:2019

    # Store Caddy's state (like certificates) in /data/caddy
    # This directory should be mounted as a volume for persistence
    storage file_system {
        root /data/caddy
    }

    # Disable automatic HTTPS because k8s handles certificates
    auto_https off
}

# Default server block for HTTP on port 80.
# Caddy will automatically redirect HTTP to HTTPS if a domain is specified and HTTPS is enabled.
http://:8888 {

    log {
        output stdout # Log to container's stdout
        format console
    }

    route /api/* {
      reverse_proxy localhost:5000
    }

    route /dash/* {
        root * /var/tmp
        file_server
        try_files {path} {path}/index.html
        encode zstd gzip
    }
}
