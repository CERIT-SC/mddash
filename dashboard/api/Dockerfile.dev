# API container - Development version with hot reload and debug mode

FROM python:3.12-slim

WORKDIR /app

RUN groupadd -g 1000 app && useradd -u 1000 -g 1000 -M -s /usr/sbin/nologin app

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl git \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt watchdog

COPY --chown=app:app . .

RUN mkdir -p /mddash && chown app:app /mddash

USER app

ENV DATA_DIR=/mddash
ENV FLASK_DEBUG=1
ENV FLASK_ENV=development
ENV LOG_LEVEL=INFO

EXPOSE 5000

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD curl --fail http://localhost:5000/health || exit 1

# Use Flask dev server with auto-reload instead of gunicorn
CMD ["python", "-m", "flask", "run", "--host=0.0.0.0", "--port=5000", "--reload"]
