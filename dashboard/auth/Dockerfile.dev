# Auth container - Development version with debug mode

FROM python:3.12-alpine

WORKDIR /app

RUN addgroup -g 1000 -S app && adduser -u 1000 -S app -G app

COPY requirements.txt requirements-dev.txt ./
RUN pip install --no-cache-dir -r requirements-dev.txt

COPY --chown=app:app auth.py .

USER app

ENV FLASK_DEBUG=1
ENV FLASK_ENV=development

EXPOSE 5001

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --spider --quiet http://localhost:5001/health || exit 1

# Use Flask dev server with auto-reload instead of gunicorn
CMD ["python", "-m", "flask", "--app=auth", "run", "--host=0.0.0.0", "--port=5001", "--reload"]
