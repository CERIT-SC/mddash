{
  "name": "jupyterlab-pipeline-tracker",
  "version": "0.1.0",
  "description": "JupyterLab extension prototype for MD notebook pipeline progress tracking.",
  "private": true,
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "style": "style/index.css",
  "files": [
    "lib/**/*",
    "style/**/*",
    "package.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && jupyter labextension build .",
    "build:lib": "tsc -p tsconfig.json",
    "watch": "tsc -w -p tsconfig.json",
    "clean": "rimraf lib tsconfig.tsbuildinfo jupyterlab_pipeline_tracker/labextension"
  },
  "dependencies": {
    "@jupyterlab/application": "^4.2.5",
    "@jupyterlab/docregistry": "^4.2.5",
