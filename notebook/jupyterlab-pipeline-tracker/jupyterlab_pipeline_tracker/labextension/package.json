    "@lumino/widgets": "^2.4.0"
  },
  "devDependencies": {
    "@jupyterlab/builder": "^4.2.5",
    "@types/json-schema": "^7.0.15",
    "rimraf": "^5.0.5",
    "typescript": "~5.8.3"
  },
  "jupyterlab": {
    "extension": true,
    "outputDir": "jupyterlab_pipeline_tracker/labextension",
    "_build": {
      "load": "static\\remoteEntry.e8908aae088b912a1686.js",
      "extension": "./extension",
      "style": "./style"
    }
  },
  "sideEffects": [
    "style/index.css"
  ]
